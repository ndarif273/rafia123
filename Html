<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="description" content="Fresh product reviews, guides, technology, lifestyle and AI insights.">
<title>FreshReview — Smart Reviews & AI</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#f7f9fc;
  --card:#ffffff;
  --text:#101828;
  --muted:#667085;
  --line:#e7ebf0;
  --primary:#315bea;
  --primary2:#6947e8;
  --shadow:0 10px 35px rgba(16,24,40,.07);
  --radius:22px;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}

button,input,textarea{
  font:inherit;
}

/* HEADER */

.header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--line);
}

.nav{
  max-width:1180px;
  margin:auto;
  height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 18px;
}

.logo{
  font-size:22px;
  font-weight:800;
  letter-spacing:-.5px;
}

.logo span{
  color:var(--primary);
}

.menu{
  display:flex;
  gap:25px;
  align-items:center;
}

.menu a{
  font-size:14px;
  font-weight:600;
  color:#475467;
}

.menu a:hover{
  color:var(--primary);
}

/* HERO */

.hero{
  max-width:1180px;
  margin:35px auto 25px;
  padding:0 18px;
}

.heroBox{
  border-radius:30px;
  padding:55px 30px;
  background:
  radial-gradient(circle at 90% 10%,rgba(105,71,232,.22),transparent 30%),
  radial-gradient(circle at 10% 90%,rgba(49,91,234,.18),transparent 30%),
  #fff;
  border:1px solid var(--line);
  box-shadow:var(--shadow);
  text-align:center;
}

.heroBox h1{
  max-width:750px;
  margin:auto;
  font-size:clamp(32px,6vw,58px);
  line-height:1.05;
  letter-spacing:-2px;
}

.heroBox h1 span{
  color:var(--primary);
}

.heroBox p{
  max-width:650px;
  margin:18px auto 0;
  color:var(--muted);
  font-size:16px;
}

/* SEARCH */

.searchArea{
  max-width:1180px;
  margin:20px auto 30px;
  padding:0 18px;
}

.searchBox{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:12px;
  display:flex;
  gap:10px;
  box-shadow:var(--shadow);
}

.searchBox input{
  flex:1;
  border:0;
  outline:0;
  padding:12px;
  background:transparent;
  color:var(--text);
}

.searchBox button{
  border:0;
  background:var(--primary);
  color:#fff;
  padding:0 20px;
  border-radius:13px;
  cursor:pointer;
  font-weight:700;
}

/* POSTS */

.section{
  max-width:1180px;
  margin:35px auto;
  padding:0 18px;
}

.sectionHead{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.sectionHead h2{
  font-size:25px;
  letter-spacing:-.5px;
}

.posts{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.post{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  cursor:pointer;
  transition:.25s;
  box-shadow:0 5px 20px rgba(16,24,40,.035);
}

.post:hover{
  transform:translateY(-5px);
  box-shadow:var(--shadow);
}

.postImg{
  width:100%;
  height:210px;
  object-fit:cover;
  display:block;
}

.postContent{
  padding:19px;
}

.category{
  display:inline-block;
  font-size:11px;
  color:var(--primary);
  background:#eef2ff;
  padding:5px 9px;
  border-radius:30px;
  font-weight:700;
  margin-bottom:9px;
}

.post h3{
  font-size:19px;
  line-height:1.3;
  margin-bottom:8px;
}

.post p{
  color:var(--muted);
  font-size:14px;
}

.readMore{
  display:block;
  margin-top:15px;
  color:var(--primary);
  font-size:13px;
  font-weight:700;
}

/* AI */

.aiSection{
  max-width:1180px;
  margin:55px auto;
  padding:0 18px;
}

.aiBox{
  background:#101828;
  color:white;
  border-radius:28px;
  padding:35px;
  box-shadow:var(--shadow);
}

.aiTop{
  margin-bottom:22px;
}

.aiTop h2{
  font-size:30px;
}

.aiTop p{
  color:#98a2b3;
  margin-top:5px;
}

.aiInput{
  width:100%;
  min-height:130px;
  resize:vertical;
  border:1px solid #344054;
  background:#1d2939;
  color:#fff;
  border-radius:17px;
  padding:17px;
  outline:0;
}

.aiInput:focus{
  border-color:#6172f3;
}

.aiActions{
  display:flex;
  gap:10px;
  margin-top:12px;
}

.askBtn,
.copyBtn{
  border:0;
  border-radius:13px;
  padding:12px 18px;
  cursor:pointer;
  font-weight:700;
}

.askBtn{
  background:#fff;
  color:#101828;
}

.copyBtn{
  background:#344054;
  color:#fff;
}

.aiResult{
  display:none;
  margin-top:20px;
  background:#1d2939;
  border:1px solid #344054;
  border-radius:17px;
  padding:20px;
  white-space:pre-wrap;
}

/* ARTICLE */

.articlePage{
  display:none;
  max-width:900px;
  margin:35px auto;
  padding:0 18px;
}

.articleBox{
  background:#fff;
  border:1px solid var(--line);
  border-radius:25px;
  overflow:hidden;
  box-shadow:var(--shadow);
}

.articleImage{
  width:100%;
  height:430px;
  object-fit:cover;
}

.articleContent{
  padding:35px;
}

.backBtn{
  display:inline-block;
  border:0;
  background:#eef2f6;
  color:#344054;
  padding:9px 14px;
  border-radius:10px;
  cursor:pointer;
  margin-bottom:22px;
}

.articleContent h1{
  font-size:clamp(30px,5vw,48px);
  line-height:1.1;
  letter-spacing:-1.5px;
  margin-bottom:15px;
}

.articleText{
  color:#475467;
  font-size:17px;
}

.articleText p{
  margin:20px 0;
}

.articleText h2{
  color:#101828;
  margin-top:30px;
  margin-bottom:10px;
}

/* FOOTER */

footer{
  margin-top:60px;
  background:#101828;
  color:#98a2b3;
  padding:35px 18px;
  text-align:center;
}

footer strong{
  color:#fff;
}

/* MOBILE */

@media(max-width:850px){
  .posts{
    grid-template-columns:repeat(2,1fr);
  }

  .menu{
    display:none;
  }
}

@media(max-width:600px){
  .nav{
    height:62px;
  }

  .heroBox{
    padding:40px 20px;
  }

  .posts{
    grid-template-columns:1fr;
  }

  .postImg{
    height:220px;
  }

  .aiBox{
    padding:24px 18px;
  }

  .articleImage{
    height:250px;
  }

  .articleContent{
    padding:23px;
  }
}
</style>
